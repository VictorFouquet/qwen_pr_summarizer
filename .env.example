# Copy this file to `.env` (which is git-ignored) and fill in your values.
#   cp .env.example .env
# main.py loads .env automatically; nothing needs to be exported.

# GitHub personal access token with read access to the repos you summarize.
GITHUB_TOKEN=ghp_your_token_here

# Optional: override the local Ollama model (default: qwen3:8b)
# PR_SUMMARIZER_MODEL=qwen3:8b
